8EF9   // 65:         LDI R7, 0xF9
82FF   // 66:         LDI R1, 0xFF
A3C0   // 67:         ST R1, [R7]
// ================= Part F =================
8EF5   // 68:         LDI R7, 0xF5
8203   // 69:         LDI R1, 0x03
A3C0   // 6A:         ST R1, [R7]
8EFC   // 6B:         LDI R7, 0xFC
93C0   // 6C: waitF1: LD R1, [R7]
3250   // 6D:         AND R1, R1, R2
C0FD   // 6E:         BNZ waitF1
8EF5   // 6F:         LDI R7, 0xF5
8213   // 70:         LDI R1, 0x13
A3C0   // 71:         ST R1, [R7]
8EFC   // 72:         LDI R7, 0xFC
8440   // 73:         LDI R2, 0x40
93C0   // 74: waitF2: LD R1, [R7]
3250   // 75:         AND R1, R1, R2
