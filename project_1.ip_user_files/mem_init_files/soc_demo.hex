// =============================================================================
// File        : soc_demo.hex
// Project     : RISC-8 5-stage CPU + 8-bit Timer/ADC Peripheral
// Author      : Le Ky Dung
// Student ID  : SE190745
// Description : Assembled firmware, one 16-bit instruction per line.
//               Loaded into imem with $readmemh. Text after // is ignored.
// =============================================================================
// Format: <hex>   // <address>: <label> <instruction>
// ================= Part A: read ID =================
8EFF   // 00:         LDI R7, 0xFF
93C0   // 01:         LD R1, [R7]
8C80   // 02:         LDI R6, 0x80
A380   // 03:         ST R1, [R6]
8410   // 04:         LDI R2, 0x10
8601   // 05:         LDI R3, 1
1D98   // 06:         ADD R6, R6, R3
// ================= Part B =================
8EF6   // 07:         LDI R7, 0xF6
8203   // 08:         LDI R1, 3
A3C0   // 09:         ST R1, [R7]
8EF7   // 0A:         LDI R7, 0xF7
8200   // 0B:         LDI R1, 0
A3C0   // 0C:         ST R1, [R7]
8EF5   // 0D:         LDI R7, 0xF5
8213   // 0E:         LDI R1, 0x13
A3C0   // 0F:         ST R1, [R7]
8EFC   // 10:         LDI R7, 0xFC
93C0   // 11: waitB:  LD R1, [R7]
3250   // 12:         AND R1, R1, R2
C0FD   // 13:         BNZ waitB
8EFB   // 14:         LDI R7, 0xFB
93C0   // 15:         LD R1, [R7]
A380   // 16:         ST R1, [R6]
1D98   // 17:         ADD R6, R6, R3
8EFA   // 18:         LDI R7, 0xFA
93C0   // 19:         LD R1, [R7]
A380   // 1A:         ST R1, [R6]
1D98   // 1B:         ADD R6, R6, R3
// ================= Part C =================
8EF1   // 1C:         LDI R7, 0xF1
8203   // 1D:         LDI R1, 3
A3C0   // 1E:         ST R1, [R7]
8EF2   // 1F:         LDI R7, 0xF2
8218   // 20:         LDI R1, 24
A3C0   // 21:         ST R1, [R7]
8EF3   // 22:         LDI R7, 0xF3
820C   // 23:         LDI R1, 12
A3C0   // 24:         ST R1, [R7]
8EF5   // 25:         LDI R7, 0xF5
8225   // 26:         LDI R1, 0x25
A3C0   // 27:         ST R1, [R7]
8EF0   // 28:         LDI R7, 0xF0
8201   // 29:         LDI R1, 1
A3C0   // 2A:         ST R1, [R7]
8A04   // 2B:         LDI R5, 4
88FF   // 2C:         LDI R4, 0xFF
8EFC   // 2D: loopC:  LDI R7, 0xFC
93C0   // 2E: waitC:  LD R1, [R7]
3250   // 2F:         AND R1, R1, R2
C0FD   // 30:         BNZ waitC
8EFB   // 31:         LDI R7, 0xFB
93C0   // 32:         LD R1, [R7]
A380   // 33:         ST R1, [R6]
1D98   // 34:         ADD R6, R6, R3
8EFA   // 35:         LDI R7, 0xFA
93C0   // 36:         LD R1, [R7]
A380   // 37:         ST R1, [R6]
1D98   // 38:         ADD R6, R6, R3
1B60   // 39:         ADD R5, R5, R4
C0F2   // 3A:         BNZ loopC
8EF5   // 3B:         LDI R7, 0xF5
8201   // 3C:         LDI R1, 0x01
A3C0   // 3D:         ST R1, [R7]
8EF0   // 3E:         LDI R7, 0xF0
8200   // 3F:         LDI R1, 0
