8204   // 45:         LDI R1, 0x04
A3C0   // 46:         ST R1, [R7]
93C0   // 47:         LD R1, [R7]
A380   // 48:         ST R1, [R6]
1D98   // 49:         ADD R6, R6, R3
823F   // 4A:         LDI R1, 0x3F
A3C0   // 4B:         ST R1, [R7]
// ================= Part D =================
8EF9   // 4C:         LDI R7, 0xF9
8264   // 4D:         LDI R1, 100
A3C0   // 4E:         ST R1, [R7]
8EFD   // 4F:         LDI R7, 0xFD
8208   // 50:         LDI R1, 0x08
