1D98   // 5C:         ADD R6, R6, R3
A3C0   // 5D:         ST R1, [R7]
8EFA   // 5E:         LDI R7, 0xFA
93C0   // 5F:         LD R1, [R7]
A380   // 60:         ST R1, [R6]
1D98   // 61:         ADD R6, R6, R3
8EFD   // 62:         LDI R7, 0xFD
8200   // 63:         LDI R1, 0
